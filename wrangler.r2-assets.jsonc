{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpt-image-assets-api",
  "main": "workers/r2-assets.js",
  "compatibility_date": "2026-05-07",
  "routes": [
    {
      "pattern": "upload.onlyzhuya.xyz",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "gpt-image-playground-assets"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UploadQuota"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["UploadQuota"]
    }
  ]
}
